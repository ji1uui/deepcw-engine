<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="False"/>
        <MainUnitHasTitleStatement Value="False"/>
        <MainUnitHasScaledStatement Value="False"/>
      </Flags>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="DeepCW Morse Station"/>
      <UseAppBundle Value="False"/>
      <ResourceType Value="res"/>
    </General>
    <VersionInfo>
      <UseVersionInfo Value="True"/>
      <MajorVersionNr Value="1"/>
      <StringTable ProductName="DeepCW Morse Station" FileDescription="Morse transmit and receive on the DeepCW model"/>
    </VersionInfo>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="deepcw_station.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="frmmain.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="FrmMain"/>
      </Unit>
      <Unit>
        <Filename Value="transcriptview.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TranscriptView"/>
      </Unit>
      <Unit>
        <Filename Value="../src/deepcw.types.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="DeepCW.Types"/>
      </Unit>
      <Unit>
        <Filename Value="../src/deepcw.metadata.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="DeepCW.Metadata"/>
      </Unit>
      <Unit>
        <Filename Value="../src/deepcw.wave.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="DeepCW.Wave"/>
      </Unit>
      <Unit>
        <Filename Value="../src/deepcw.dsp.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="DeepCW.Dsp"/>
      </Unit>
      <Unit>
        <Filename Value="../src/deepcw.onnx.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="DeepCW.Onnx"/>
      </Unit>
      <Unit>
        <Filename Value="../src/deepcw.decoder.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="DeepCW.Decoder"/>
      </Unit>
      <Unit>
        <Filename Value="../src/deepcw.morse.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="DeepCW.Morse"/>
      </Unit>
      <Unit>
        <Filename Value="../src/deepcw.audio.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="DeepCW.Audio"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="deepcw_station"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <OtherUnitFiles Value="../src"/>
      <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <Linking>
      <Options>
        <Win32>
          <GraphicApplication Value="True"/>
        </Win32>
      </Options>
    </Linking>
  </CompilerOptions>
</CONFIG>
